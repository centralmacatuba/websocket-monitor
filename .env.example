# Copy to .env for local monitoring. Never commit real endpoint URLs or credentials.
WS_MONITOR_ENABLED=true
WS_MONITOR_INTERVAL_MINUTES=5
MCRAFT_P2P_MONITOR_ENABLED=
MCRAFT_P2P_MONITOR_INTERVAL_MINUTES=
MCRAFT_P2P_WS_URL=
EAGLERCRAFT_RELAY_MONITOR_ENABLED=
EAGLERCRAFT_RELAY_MONITOR_INTERVAL_MINUTES=
EAGLERCRAFT_RELAY_WS_URL=
MCRAFT_P2P_PEERJS_MONITOR_ENABLED=
MCRAFT_P2P_PEERJS_MONITOR_INTERVAL_MINUTES=
MCRAFT_P2P_PEERJS_WS_URL=
EAGLERCRAFT_WISP_MONITOR_ENABLED=
EAGLERCRAFT_WISP_MONITOR_INTERVAL_MINUTES=
EAGLERCRAFT_WISP_WS_URL=
GITHUB_TOKEN=
GITHUB_REPOSITORY=centralmacatuba/websocket-monitor

# Incident confirmation and ownership
WS_INCIDENT_CONFIRMATION_FAILURES=2
WS_MONITOR_ASSIGNEES_JSON={}

# External notifications (disabled unless enabled or credentials are present)
WS_NOTIFY_DISCORD_ENABLED=false
WS_NOTIFY_DISCORD_WEBHOOK_URL=
WS_NOTIFY_TELEGRAM_ENABLED=false
WS_NOTIFY_TELEGRAM_BOT_TOKEN=
WS_NOTIFY_TELEGRAM_CHAT_ID=
WS_NOTIFY_WEBHOOK_ENABLED=false
WS_NOTIFY_WEBHOOK_URL=
WS_NOTIFY_WEBHOOK_SECRET=
WS_NOTIFY_TIMEOUT_MS=8000
